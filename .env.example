# SchuBase Auto Pilot Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Blackboard URL (don't change this)
BB_BASE_URL=https://learn.dcollege.net

# Your Drexel credentials for auto-login
DREXEL_USERNAME=abc123@drexel.edu
DREXEL_PASSWORD=your_password_here

# For browser-use AI agent (Gemini Flash — free with Google Pro)
# Get yours at https://aistudio.google.com/apikey
GOOGLE_API_KEY=AIza...
GEMINI_API_KEY=AIza...

# Password to access the SchuBase dashboard (required for public deployment)
SCHUBASE_PASSWORD=choose_a_strong_password

# Secret key for session encryption (auto-generated if not set)
# SECRET_KEY=random_hex_string
