# Drexel Autopilot Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Blackboard URL (don't change this)
BB_BASE_URL=https://learn.dcollege.net

# Your Drexel credentials for auto-login
# The app uses a headless browser to log into Blackboard via
# Drexel Connect SSO — credentials only go to Drexel's servers.
DREXEL_USERNAME=abc123@drexel.edu
DREXEL_PASSWORD=your_password_here

# For browser-use AI agent (optional but recommended)
# Makes login smarter — handles SSO redirects, MFA prompts, etc.
# Get yours at https://aistudio.google.com/apikey (free with Google Pro)
GOOGLE_API_KEY=AIza...
