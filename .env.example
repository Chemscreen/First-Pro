# Blackboard LMS Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Your college's Blackboard URL (REQUIRED)
BB_BASE_URL=https://yourcollege.blackboard.com

# ── Option A: REST API credentials ──
# Get these from your college's Blackboard admin or developer portal
BB_API_KEY=
BB_API_SECRET=

# ── Option B: Browser session cookies ──
# 1. Log into Blackboard in your browser
# 2. Open DevTools (F12) > Application > Cookies
# 3. Copy the cookie string here
BB_COOKIES=
