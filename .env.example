# Drexel Autopilot Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Blackboard URL (don't change this)
BB_BASE_URL=https://learn.dcollege.net

# Your Drexel credentials for auto-login
# The app uses Playwright (headless browser) to log into
# Blackboard via Drexel Connect SSO — your credentials are
# ONLY sent to Drexel's own servers, never anywhere else.
DREXEL_USERNAME=abc123
DREXEL_PASSWORD=your_password_here
