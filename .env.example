# Drexel University LMS Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ══════════════════════════════════════════════════
# CANVAS (New - most courses are moving here)
# ══════════════════════════════════════════════════
# Drexel's Canvas URL
CANVAS_BASE_URL=https://drexel.instructure.com

# Your Canvas API token (EASY to get - no cookies needed!)
# 1. Log into Canvas at https://drexel.instructure.com
# 2. Click your profile icon (top left) > Settings
# 3. Scroll to "Approved Integrations" > click "+ New Access Token"
# 4. Give it a name like "CourseHelper", click "Generate Token"
# 5. Copy the token and paste it here
CANVAS_TOKEN=

# ══════════════════════════════════════════════════
# BLACKBOARD / DREXEL LEARN (Legacy - being phased out)
# ══════════════════════════════════════════════════
# Only needed if you still have courses on Blackboard
BB_BASE_URL=https://learn.dcollege.net

# Browser session cookies (for Blackboard only)
# 1. Log into https://learn.dcollege.net with Drexel Connect
# 2. Press F12 > Network tab > refresh > click any request
# 3. Copy the "Cookie" header value
BB_COOKIES=
